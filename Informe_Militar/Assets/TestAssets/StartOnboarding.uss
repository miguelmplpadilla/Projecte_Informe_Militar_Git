.janeHorizontal {
    max-height: 800px;
    flex-grow: 1;
    background-size: contain;
    background-image: url("project://database/Assets/TestAssets/Jane.png?fileID=2800000&guid=053ee892bcfec8f4ab9512d17072daa9&type=3#Jane");
}

.janeVertical {
    background-image: url("project://database/Assets/TestAssets/Jane.png?fileID=2800000&guid=053ee892bcfec8f4ab9512d17072daa9&type=3#Jane");
    background-size: cover;
    max-height: 800px;
    flex-grow: 1;
}

.button {
    justify-content: center;
    width: 100%;
    align-self: center;
    height: 135px;
    max-width: 823px;
    font-size: 60%;
    -unity-font-style: normal;
    margin-top: 20px;
    margin-bottom: 20px;
    background-image: url("project://database/Assets/TestAssets/new_onboarding_assets.png?fileID=733258448&guid=2c4edb0459dede14ba3b237407b36ba2&type=3#button");
    -unity-slice-scale: 2.5px;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    max-height: 135px;
    background-size: 100% 100%;
}

.continerButtonsVertical {
    align-items: center;
    align-self: center;
    width: 75%;
    height: 40%;
    flex-grow: 1;
}

.continerButtonsHorizontal {
    align-items: center;
    align-self: center;
    width: 75%;
    height: 40%;
    flex-grow: 1;
}
